# Set this in Vercel Project Settings -> Environment Variables.
# Leave unset only if your API is deployed under the same Vercel project at /api.
VITE_API_URL=https://your-backend-api.example.com

# Keep disabled for fastest first load. Enable only if you really want the
# slow ecosystem initialization request to run automatically after page load.
VITE_ENABLE_STARTUP_INIT=
